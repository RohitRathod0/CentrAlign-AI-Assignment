# Mistral replaces Anthropic for this build (free-tier key from https://console.mistral.ai)
MISTRAL_API_KEY=
LLM_MODEL=mistral-large-latest
# Free tier allows roughly 1 request/second; calls are spaced by this many seconds
LLM_MIN_INTERVAL_S=1.2

# 1 = mock apps inject failures for every request (agent runs can also enable it per run)
CHAOS=0
# 1 = run Chromium without a window (tests); 0 = headed (demo)
HEADLESS=0
LEDGER_API_KEY=dev-ledger-key
